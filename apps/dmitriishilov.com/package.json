{
  "name": "dmitriishilov.com",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "typecheck": "astro check",
    "format:astro": "prettier --plugin prettier-plugin-astro --write \"src/**/*.astro\"",
    "format:astro:check": "prettier --plugin prettier-plugin-astro --check \"src/**/*.astro\"",
    "pdf": "astro check && astro build && node scripts/generate-pdf.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "astro": "astro"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.17.4",
    "@astrojs/check": "^0.9.10",
    "alpinejs": "^3.17.4",
    "astro": "^7.3.5",
    "astro-font-picker": "^0.2.2",
    "hotkeypad": "^1.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.17.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
