{
  "name": "czech-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json src/server/index.ts",
    "build": "vite build",
    "build:server": "node ../../scripts/buildServer.mjs",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "auth:create-user": "tsx --tsconfig tsconfig.scripts.json scripts/create-user.ts",
    "ocr:import": "tsx --tsconfig tsconfig.scripts.json scripts/ocr-import.ts ./images/",
    "import:words": "tsx --tsconfig tsconfig.scripts.json scripts/import-words.ts",
    "lint": "oxlint --quiet --config ../../.oxlintrc.jsonc",
    "lint:fix": "oxlint --fix --config ../../.oxlintrc.jsonc",
    "format": "oxfmt --config ../../.oxfmtrc.json",
    "format:check": "oxfmt --check --config ../../.oxfmtrc.json",
    "preview": "vite preview",
    "checkup": "npm run typecheck && npm run test && npm run lint && npm run format:check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@hono/node-server": "^2.0.4",
    "@libsql/client": "^0.17.3",
    "@tanstack/react-query": "^5.100.14",
    "antd": "^6.4.3",
    "antd-style": "^4.1.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.22",
    "hono-rate-limiter": "^0.5.3",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "otpauth": "^9.5.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.13",
    "@personal-hub/auth-server": "*",
    "@personal-hub/browser": "*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1"
  }
}
