{
  "name": "tg-news-reader",
  "version": "1.34.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json src/server/index.ts",
    "build": "vite build",
    "build:client": "tsc",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "build:server": "node ../../scripts/buildServer.mjs",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "auth:create-user": "tsx --tsconfig tsconfig.scripts.json scripts/create-user.ts",
    "media:cleanup": "tsx --tsconfig tsconfig.scripts.json scripts/media-cleanup/cleanupMedia.ts",
    "tg:auth": "tsx --tsconfig tsconfig.scripts.json scripts/tg-auth.ts",
    "lint": "oxlint --quiet --config ../../.oxlintrc.jsonc",
    "lint:fix": "oxlint --fix --config ../../.oxlintrc.jsonc",
    "format": "oxfmt --config ../../.oxfmtrc.json",
    "format:check": "oxfmt --check --config ../../.oxfmtrc.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "checkup": "npm run typecheck && npm run test && npm run lint && npm run format:check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@azure/cosmos": "^4.10.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "@mozilla/readability": "^0.6.0",
    "@personal-hub/auth-server": "*",
    "@personal-hub/browser": "*",
    "@tanstack/react-query": "^5.104.0",
    "@types/turndown": "^5.0.6",
    "antd": "^6.6.5",
    "antd-style": "^4.1.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "hono-rate-limiter": "^0.5.4",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsdom": "^30.1.1",
    "openai": "^7.25.0",
    "otpauth": "^9.5.2",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.16",
    "remark-gfm": "^4.0.1",
    "telegram": "^2.26.22",
    "turndown": "^7.2.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
